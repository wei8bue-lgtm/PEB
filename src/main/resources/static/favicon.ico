// FaviconController.java - Als Alternative ohne Datei
package com.peb.controller;

import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RestController;

/**
 * Liefert ein minimales favicon um Browser-Fehler zu vermeiden
 */
@RestController
public class FaviconController {

    // Minimales 1x1 pixel ICO file (Base64)
    private static final byte[] MINIMAL_FAVICON = new byte[]{
        0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x01, 0x01,
        0x00, 0x00, 0x01, 0x00, 0x18, 0x00, 0x30, 0x00,
        0x00, 0x00, 0x16, 0x00, 0x00, 0x00, 0x28, 0x00,
        0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x02, 0x00,
        0x00, 0x00, 0x01, 0x00, 0x18, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x66,
        (byte)0xcc, 0x00, 0x00, 0x00, 0x00, 0x00
    };

    @GetMapping(value = "/favicon.ico",
                produces = "image/x-icon")
    public ResponseEntity<byte[]> favicon() {
        return ResponseEntity.ok()
                .contentType(MediaType.parseMediaType("image/x-icon"))
                .body(MINIMAL_FAVICON);
    }
}